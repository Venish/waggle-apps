{
  "name": "waggle-monorepo",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@repo/web",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:ping": "pnpm --filter @repo/db run ping",
    "db:push": "pnpm --filter @repo/db run db:push",
    "db:seed": "pnpm --filter @repo/db run seed",
    "clean": "turbo clean"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.2"
  }
}
