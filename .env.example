# ==============================================================================
# Waggle Monorepo — Environment Template (.env.example)
# 로컬 세팅 시 본 파일을 복사하여 루트에 `.env` 파일을 만들고 접속 정보를 입력하세요.
# ==============================================================================

# 1. PostgreSQL 18 Direct Connection (Single Root .env)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=waggle_db

DATABASE_URL="postgresql://your_db_user:your_db_password@127.0.0.1:5432/waggle_db"

# 2. App URLs & 3-Domain Host Routing (Single Next.js App on :3000 — www / app / admin)
NEXT_PUBLIC_WWW_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000/app"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3000/admin"
WWW_DOMAIN_HOST="www.waggle.kr"
APP_SUBDOMAIN_HOST="app.waggle.kr"
ADMIN_SUBDOMAIN_HOST="admin.waggle.kr"

# 3. Session, Auth & Cron Security Constants (Strict .env — No Code Fallback)
SESSION_SECRET="replace-with-strong-random-secret"
CRON_SECRET="replace-with-strong-cron-secret"
APP_COOKIE_MAX_AGE_DAYS=365
ADMIN_SESSION_IDLE_MINUTES=30
ADMIN_OTP_EXPIRES_MINUTES=5
AUTH_MAX_LOGIN_ATTEMPTS=5

# 4. Local File Uploads (상대경로는 모노레포 루트 기준, 운영 볼륨/NAS는 절대경로 지정 가능)
UPLOAD_DIR="./uploads"
UPLOAD_PUBLIC_BASE_URL="/api/uploads"

# 5. External Integrations (Optional — Enable when Wave 1/2 features require them)
# PortOne Web Payment & Webhook
PORTONE_API_SECRET=""
PORTONE_WEBHOOK_SECRET=""

# Social OAuth (Kakao / Apple / Google / Naver)
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""
APPLE_CLIENT_ID=""

# Admin SMS 2FA & Push Notification (FCM)
SMS_API_KEY=""
SMS_API_SECRET=""
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Object Storage (S3 / R2 / GCS)
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
